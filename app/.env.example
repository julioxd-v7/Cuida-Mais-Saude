# Copie este arquivo para ".env" e preencha com os valores do seu ambiente.
# O arquivo .env NÃO vai para o Git.
#
# ATENÇÃO: variáveis EXPO_PUBLIC_* ficam embutidas no aplicativo e podem ser
# lidas por qualquer pessoa. Nunca coloque aqui senhas, tokens, chaves privadas
# ou credenciais de provedores (pagamento, mapas com permissão de servidor etc.).
# Esses segredos ficam somente no backend.

# Ambiente: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Endereço do backend (pasta backend/, porta 3333), sem barra no final.
# No celular, use o IP do seu computador na rede (ipconfig), não "localhost".
# Exemplo: EXPO_PUBLIC_API_URL=http://192.168.0.10:3333
EXPO_PUBLIC_API_URL=

# (Opcional) WhatsApp do suporte, com DDI e DDD, só números. Ex.: 5511912345678
# Sem valor, o app não mostra o botão "Falar pelo WhatsApp".
EXPO_PUBLIC_SUPPORT_WHATSAPP=

# (Opcional) Login com Google — client IDs OAuth criados no Google Cloud Console.
# São públicos (identificam o app). O "Web" é obrigatório para o botão aparecer;
# o mesmo valor vai em GOOGLE_CLIENT_IDS no backend/.env. Não funciona no Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
