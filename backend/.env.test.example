# Copie para ".env.test". Os testes criam um schema temporário (test_xxxx)
# neste banco, rodam e apagam o schema no final. Os dados reais do schema
# "app" não são tocados. Pode ser o mesmo DATABASE_URL do .env.
TEST_DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
TEST_DATABASE_SSL=require
