{
  "name": "cuidar-mais-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "admin:grant": "tsx --env-file=.env src/scripts/grantAdmin.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env.test --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  }
}
