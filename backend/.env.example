# Copie para ".env" e preencha. O arquivo .env NUNCA vai para o Git.

NODE_ENV=development
HOST=0.0.0.0
PORT=3333

# Conexão com o PostgreSQL. No Supabase: Project Settings > Database >
# Connection string > "Session pooler" (porta 5432). Troque [YOUR-PASSWORD]
# pela senha do banco. Não use o "Transaction pooler" (porta 6543).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Schema onde ficam as tabelas do CUIDAR MAIS.
DATABASE_SCHEMA=app

# require = conexão criptografada (padrão) | verify = criptografada e com
# verificação do certificado (exige DATABASE_CA_CERT) | disable = só para
# Postgres local na sua máquina.
DATABASE_SSL=require
# DATABASE_CA_CERT=./prod-ca-2021.crt

# Duração das sessões.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Versão dos termos aceitos no cadastro.
TERMS_VERSION=2026-10-rascunho

# Origens liberadas para o app rodando no navegador (Expo web).
CORS_ORIGINS=http://localhost:8081

# Envio do código de recuperação de senha:
# console = imprime o código no terminal do backend (SÓ desenvolvimento)
# none    = recuperação indisponível (até configurar um provedor de e-mail)
MAIL_TRANSPORT=console

# Armazenamento PRIVADO dos documentos dos profissionais (Supabase Storage).
# Supabase → Project Settings → API Keys → "Secret keys" (sb_secret_...).
# ESTA CHAVE DÁ ACESSO TOTAL AO PROJETO: só aqui no backend, nunca no app,
# nunca no Git. Sem ela, o envio de documentos responde "indisponível".
SUPABASE_URL=https://bmchxezjuextpdpkcewv.supabase.co
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=caregiver-documents

# (Opcional) Login com Google: client IDs OAuth aceitos, separados por vírgula.
# Use o client ID do tipo "Web" (o mesmo de EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID no app).
# Vazio = login com Google desligado (o endpoint responde 503).
GOOGLE_CLIENT_IDS=
